# SalonBook Server Environment Variables Template
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB URI (leave empty in development to automatically use in-memory MongoDB)
MONGODB_URI=
DB_NAME=salonbook

# Authentication & JWT
JWT_SECRET=salonbook_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Default Admin Credentials
ADMIN_EMAIL=admin@salonbook.com
ADMIN_PASSWORD=Admin123!

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_setup
STRIPE_WEBHOOK_SECRET=

# Image Upload (ImgBB)
IMGBB_API_KEY=

# Public API URL
PUBLIC_API_URL=http://localhost:5000
